{
  "manifest_version": 3,
  "name": "Terms Lens",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "See the clauses that deserve your attention before you agree.",
  "permissions": ["scripting", "storage", "sidePanel", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Terms Lens"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
